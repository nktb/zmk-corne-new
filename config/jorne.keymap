#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        game_esc {
            bindings = <&kp ESC>;
            key-positions = <2 3>;
            layers = <0>;
        };

        lang_switch {
            bindings = <&kp F19>;
            key-positions = <30 29>;
            layers = <0>;
        };

        l3_on {
            bindings = <&sl 3>;
            key-positions = <39 42>;
            layers = <0>;
        };

        backspace_right {
            bindings = <&kp BACKSPACE>;
            key-positions = <30 31>;
            layers = <0>;
        };

        tab_right {
            bindings = <&none>;
            key-positions = <18 19>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // Jorne: 44 keys (positions 0 and 13 are extra outer keys, not present physically)
            // -----------------------------------------------------------------------------------------
            // | x |  ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP | x |
            //     | TAB  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  '  |  '   |
            //     | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
            //                        | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none  &kp LCTRL       &kp Q  &kp W  &kp E             &kp R  &kp T        &kp Y      &kp U  &kp I          &kp O    &kp P          &kp LEFT_BRACKET   &none
       &kp LEFT_ALT    &kp A  &kp S  &kp D             &kp F  &kp G        &kp H      &kp J  &kp K          &kp L    &kp SEMICOLON  &kp RIGHT_BRACKET
       &kp LEFT_SHIFT  &kp Z  &kp X  &kp C             &kp V  &kp B        &kp N      &kp M  &kp COMMA      &kp DOT  &kp SQT        &kp FSLH
                                     &kp LEFT_COMMAND  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp BACKSPACE
            >;
        };

        num {
            bindings = <
&none  &trans  &kp N1           &kp N2         &kp N3         &kp N4      &kp N5         &kp N6     &kp N7         &kp N8         &kp N9                &kp N0                 &kp PIPE       &none
       &trans  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH       &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp TILDE
       &trans  &kp GRAVE        &kp BACKSLASH  &kp MINUS      &kp PLUS    &kp UNDER      &kp MINUS  &kp EQUAL      &kp LESS_THAN  &kp GREATER_THAN      &kp COLON              &kp BACKSLASH
                                               &kp BACKSPACE  &trans      &kp TAB        &trans     &trans         &trans
            >;
        };

        L2 {
            bindings = <
&none  &trans  &kp F1    &kp F2             &kp F3           &kp F4                &kp F5                  &kp F6   &kp F7          &kp F8          &kp F9           &kp F10        &kp DEL     &none
       &trans  &kp C_PP  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC    &kp F11  &kp HOME        &kp UP_ARROW    &kp END          &kp PAGE_UP    &kp ESCAPE
       &trans  &trans    &trans             &trans           &trans                &trans                  &kp F12  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN  &kp TAB
                                            &trans           &trans                &trans                  &trans   &trans          &trans
            >;
        };

        settings {
            bindings = <
&trans  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans       &trans        &trans  &trans
        &trans      &out OUT_TOG  &bootloader   &bt BT_CLR_ALL  &bt BT_PRV    &bt BT_NXT      &trans  &trans  &trans  &bootloader  &out OUT_TOG  &trans
        &trans      &trans        &trans        &trans          &trans        &trans          &trans  &trans  &trans  &trans       &trans        &trans
                                                &trans          &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
