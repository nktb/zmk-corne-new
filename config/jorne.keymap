#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        game_esc {
            bindings = <&kp ESC>;
            key-positions = <2 3>;
            layers = <0>;
        };

        lang_switch {
            bindings = <&kp F19>;
            key-positions = <30 29>;
            layers = <0>;
        };

        l3_on {
            bindings = <&sl 3>;
            key-positions = <39 42>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // Jorne: 44 keys (positions 0 and 13 are extra outer keys, not present physically)
            // -----------------------------------------------------------------------------------------
            // | x |  ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP | x |
            //     | TAB  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  '  |  '   |
            //     | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
            //                        | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none  &kp LCTRL       &kp Q  &kp W  &kp E             &kp R  &kp T        &kp Y      &kp U  &kp I          &kp O    &kp P          &kp LEFT_BRACKET   &none
       &kp LEFT_ALT    &kp A  &kp S  &kp D             &kp F  &kp G        &kp H      &kp J  &kp K          &kp L    &kp SEMICOLON  &kp RIGHT_BRACKET
       &kp LEFT_SHIFT  &kp Z  &kp X  &kp C             &kp V  &kp B        &kp N      &kp M  &kp COMMA      &kp DOT  &kp SQT        &kp FSLH
                                     &kp LEFT_COMMAND  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp BACKSPACE
            >;
        };

        num {
            bindings = <
&none  &trans  &kp N7  &kp N8  &kp N9   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp F1  &kp F2     &kp F3      &kp F4   &kp F5   &kp F6   &none
       &trans  &kp N4  &kp N5  &kp N6   &kp MINUS             &kp EQUAL                &kp F7  &kp F8     &kp F9      &kp F10  &kp F11  &kp F12
       &trans  &kp N1  &kp N2  &kp N3   &kp N0                &kp DOT                  &trans  &trans     &trans      &trans   &trans   &trans
                               &kp TAB  &trans                &kp BACKSPACE            &trans  &kp GRAVE  &kp DELETE
            >;
        };

        L2 {
            bindings = <
&none  &kp ESCAPE  &kp C_PLAY_PAUSE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC    &kp F3  &kp F4          &kp F5          &kp F6           &kp F7  &kp F10  &none
       &trans      &trans            &trans             &trans           &trans                &trans                  &kp F2  &kp HOME        &kp UP_ARROW    &kp END          &kp F8  &kp F11
       &trans      &trans            &trans             &trans           &trans                &trans                  &kp F1  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F9  &kp F12
                                                        &trans           &trans                &trans                  &trans  &trans          &trans
            >;
        };

        settings {
            bindings = <
&trans  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans       &trans        &trans  &trans
        &trans      &out OUT_TOG  &bootloader   &bt BT_CLR_ALL  &bt BT_PRV    &bt BT_NXT      &trans  &trans  &trans  &bootloader  &out OUT_TOG  &trans
        &trans      &trans        &trans        &trans          &trans        &trans          &trans  &trans  &trans  &trans       &trans        &trans
                                                &trans          &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
